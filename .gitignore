# Python bytecode and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Runtime-generated files
cache/
logs/
exports/
*.log
*.tmp
*.temp

# Downloaded AI models (keep model download scripts and documentation in Git)
models/*.onnx
models/*.pt
models/*.pth
models/*.ckpt
models/*.bin

# Local audio recordings and renders. Keep curated samples under samples/ tracked.
*.wav
*.mp3
*.flac
*.ogg
*.m4a
!samples/**/*.wav
!samples/**/*.mp3
!samples/**/*.flac
!samples/**/*.ogg
!samples/**/*.m4a

# Secrets and machine-local configuration
.env
.env.*
!.env.example
config/local*.json
config/*local*.json
